{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Readiness Finding",
  "type": "object",
  "required": ["score", "findings", "evidence"],
  "properties": {
    "score": {"type": "number", "minimum": 0, "maximum": 100},
    "findings": {"type": "array"},
    "evidence": {"type": "array"},
    "remediation": {"type": "array"}
  }
}
