{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cochranek.github.io/repo-auditor/audits/schema-v1.json",
  "title": "repo-auditor structured audit sidecar",
  "type": "object",
  "required": [
    "schema_version",
    "repository",
    "audit_date",
    "audited_commit",
    "markdown",
    "decision",
    "quality_gates",
    "quality_dimensions",
    "publication_gate",
    "findings",
    "limitations",
    "recheck_triggers"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "audit_date": {
      "type": "string",
      "format": "date"
    },
    "audited_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "markdown": {
      "type": "string"
    },
    "decision": {
      "type": "object"
    },
    "quality_gates": {
      "type": "object"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "title",
          "status",
          "evidence",
          "recommendation",
          "remediation_class"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "open",
              "fixed",
              "accepted",
              "not-applicable"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "recommendation": {
            "type": "string",
            "minLength": 1
          },
          "remediation_class": {
            "enum": [
              "auto-fix",
              "owner-choice",
              "external-blocked",
              "accepted-risk"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "limitations": {
      "type": "array"
    },
    "recheck_triggers": {
      "type": "array"
    },
    "publication_gate": {
      "type": "object",
      "required": [
        "current_visibility",
        "recommendation",
        "reasons"
      ],
      "properties": {
        "current_visibility": {
          "enum": [
            "public",
            "private"
          ]
        },
        "recommendation": {
          "enum": [
            "public-ok",
            "review-before-public",
            "keep-private",
            "split-public-private"
          ]
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "quality_dimensions": {
      "type": "object",
      "required": [
        "purpose_scope",
        "correctness",
        "security_privacy",
        "supply_chain",
        "reproducibility",
        "release_engineering",
        "documentation_onboarding",
        "maintainability",
        "community_surface"
      ],
      "properties": {
        "purpose_scope": {
          "type": "object",
          "required": [
            "score",
            "evidence"
          ],
          "properties": {
            "score": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 5
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        "correctness": {
          "type": "object",
          "required": [
            "score",
            "evidence"
          ],
          "properties": {
            "score": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 5
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        "security_privacy": {
          "type": "object",
          "required": [
            "score",
            "evidence"
          ],
          "properties": {
            "score": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 5
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        "supply_chain": {
          "type": "object",
          "required": [
            "score",
            "evidence"
          ],
          "properties": {
            "score": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 5
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        "reproducibility": {
          "type": "object",
          "required": [
            "score",
            "evidence"
          ],
          "properties": {
            "score": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 5
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        "release_engineering": {
          "type": "object",
          "required": [
            "score",
            "evidence"
          ],
          "properties": {
            "score": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 5
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        "documentation_onboarding": {
          "type": "object",
          "required": [
            "score",
            "evidence"
          ],
          "properties": {
            "score": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 5
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        "maintainability": {
          "type": "object",
          "required": [
            "score",
            "evidence"
          ],
          "properties": {
            "score": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 5
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        "community_surface": {
          "type": "object",
          "required": [
            "score",
            "evidence"
          ],
          "properties": {
            "score": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 5
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
